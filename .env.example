# Synapse runtime environment.
# Copy to .env and fill in. Every variable listed here is read by the code;
# nothing else is. Never commit .env.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Reminders are spoken in local terms ("at four o'clock"), so set this to
# where the person actually is, e.g. Asia/Kolkata or Europe/London.
TIME_ZONE=UTC

# --- Speech to text (local, faster-whisper) -------------------------------
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8
# Silence before a turn is finalised. Longer than a typical assistant on
# purpose: people living with dementia pause more, and cutting them off
# mid-sentence is a known failure mode.
STT_MAX_PAUSE_SECONDS=2.5

# --- Intent router (Ollama) -----------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_QWEN_MODEL=qwen2.5:3b-instruct

# --- Reasoning layer (Mistral) --------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Speech output --------------------------------------------------------
TTS_GTTS_LANG=en

# Removed, because nothing reads them:
#   ASSEMBLYAI_API_KEY / ASSEMBLYAI_STT_MODE / ASSEMBLYAI_SPEECH_MODEL
#       speech to text is done locally by faster-whisper
#   WHISPER_MODEL, USE_CUDA
#       superseded by FASTER_WHISPER_MODEL and FASTER_WHISPER_DEVICE
#   GEMINI_API_KEY, OPENAI_API_KEY, HF_TOKEN
#       no call site anywhere in the project
